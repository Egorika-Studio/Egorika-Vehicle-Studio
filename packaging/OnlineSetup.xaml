<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Egorika Vehicle Studio Setup" Width="596" Height="560"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#191C1C" Foreground="#EBEFED" FontSize="15"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EBEFED"/>
      <Setter Property="Background" Value="#262D2B"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".83"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1E2221" Padding="20,9" Height="78">
      <StackPanel>
        <TextBlock Text="Egorika Vehicle Studio Setup" FontSize="14"/>
        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
          <Border x:Name="OptionsTab" CornerRadius="6" Padding="8,4"><TextBlock x:Name="OptionsLabel"/></Border>
          <Border x:Name="InstallingTab" CornerRadius="6" Padding="8,4" Margin="10,0,0,0"><TextBlock x:Name="InstallingLabel"/></Border>
          <Border x:Name="ResultTab" CornerRadius="6" Padding="8,4" Margin="10,0,0,0"><TextBlock x:Name="ResultLabel"/></Border>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#1E2221" Height="60" Padding="20,9">
      <DockPanel LastChildFill="False">
        <ComboBox x:Name="Language" DockPanel.Dock="Left" Width="110" VerticalAlignment="Center" SelectedIndex="0">
          <ComboBoxItem Content="English"/><ComboBoxItem Content="Русский"/>
        </ComboBox>
        <Button x:Name="Primary" DockPanel.Dock="Right" Background="#77D9BC" Foreground="#10251F" IsDefault="True" VerticalAlignment="Center"/>
        <Button x:Name="Back" DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
      </DockPanel>
    </Border>
    <StackPanel Margin="24,12">
      <Image x:Name="Wordmark" Width="288" Height="144" Stretch="Uniform" HorizontalAlignment="Center"/>
      <TextBlock x:Name="Heading" FontSize="27" HorizontalAlignment="Center" Margin="0,0,0,14"/>
      <StackPanel x:Name="Options">
        <TextBlock x:Name="FolderLabel" Margin="0,0,0,5"/>
        <DockPanel>
          <Button x:Name="Browse" DockPanel.Dock="Right" Margin="8,0,0,0"/>
          <TextBox x:Name="Folder" Background="#262D2B" Foreground="#EBEFED" BorderBrush="#46534E" Padding="8,6" VerticalContentAlignment="Center" AutomationProperties.Name="Installation folder"/>
        </DockPanel>
        <CheckBox x:Name="Desktop" Margin="0,12,0,0" Foreground="#EBEFED"/>
      </StackPanel>
      <ProgressBar x:Name="Progress" Height="8" Foreground="#77D9BC" Background="#262D2B" IsIndeterminate="True" Visibility="Collapsed" Margin="0,5,0,10"/>
      <TextBlock x:Name="Status" TextWrapping="Wrap"/>
      <CheckBox x:Name="Launch" IsChecked="True" Foreground="#EBEFED" Margin="0,10,0,0" Visibility="Collapsed"/>
    </StackPanel>
  </DockPanel>
</Window>
